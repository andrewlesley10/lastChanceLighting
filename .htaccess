# Don't serve a browsable index of any directory that lacks an index file
# (this is what would otherwise expose /vids/ and /assets/ as file listings)
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ——— Force HTTPS ————————————————————————————————————————————————
  # Both conditions are needed: %{HTTPS} is the direct-TLS case, and
  # X-Forwarded-Proto covers hosts that terminate TLS at a load balancer —
  # where %{HTTPS} reads "off" even on an HTTPS request, and checking it
  # alone would produce an infinite redirect loop.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Redirect .html to non-.html version
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.html
  RewriteRule ^([^\.]+)\.html$ /$1 [R=301,L]
  
  # Redirect .php to non-.php version (GET only — never strip POST data)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.php
  RewriteCond %{REQUEST_METHOD} !POST
  RewriteRule ^([^\.]+)\.php$ /$1 [R=301,L]
  
  # Rewrite requests to .html files
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.php$
  RewriteRule ^([^\.]+)$ $1.html [NC,L]
  
  # Rewrite POST requests to .php files
  RewriteCond %{REQUEST_METHOD} ^POST$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^\.]+)$ $1.php [NC,L]
</IfModule>

# ——— Security headers ————————————————————————————————————————————————
<IfModule mod_headers.c>
  # Don't let browsers guess a file's type against its declared one
  Header always set X-Content-Type-Options "nosniff"
  # Trim what leaks in the Referer header on outbound links
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Clickjacking: only this origin may frame the site
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

  # Content Security Policy. 'unsafe-inline' is required on both script and
  # style: the theme bootstrap is an inline <script> in every <head> (it has
  # to run before paint to avoid a flash), and the pages use inline style=""
  # attributes throughout. Everything else is locked to this origin plus the
  # three third parties actually in use: Google Fonts, and the Maps embed.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; frame-src https://www.google.com; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'"

  # HSTS — browsers refuse plain HTTP for this domain for the max-age window.
  # Rolled out in stages on purpose: a long max-age CANNOT be undone quickly,
  # so if the certificate later lapses the site is unreachable for anyone who
  # has visited before. Starting at 1 day keeps the blast radius to 24 hours.
  #
  # Once HTTPS has been confirmed stable on the live domain for a week or two,
  # raise this to the full two years by swapping the max-age below for
  # 63072000 (and only then consider adding `preload`).
  Header always set Strict-Transport-Security "max-age=86400; includeSubDomains"
</IfModule>

# Never serve the raw log/config files if any end up here
<FilesMatch "\.(env|ini|log|sh|sql|bak)$">
  Require all denied
</FilesMatch>
